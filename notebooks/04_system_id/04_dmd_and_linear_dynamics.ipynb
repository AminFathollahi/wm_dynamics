    "# A_history = []\n",
    "# eig_history = []\n",
    "#\n",
    "# # Concatenate all trials in condition order\n",
    "# all_trajs = mu_np.reshape(-1, mu_np.shape[-1])  # (all_time, d)\n",
    "# for t in range(len(all_trajs) - 1):\n",
